PORT=4000

# Browser origins allowed to call the API (the web app; Expo web on 8081). Phones need no entry.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Shared secret with the vision service (its VISION_INGEST_TOKEN). At least 16 characters; keep it in .env.
# Replace this placeholder with a random value: the API refuses to start with it.
VISION_INGEST_TOKEN=change-me-to-a-long-random-string

# A camera is shown as stale (grey) after this long without a reading.
STALE_AFTER_MS=15000

# The campus files at the repo root (the defaults); override only for another campus.
# CAMERAS_FILE=../../config/cameras.json
# PLACES_FILE=../../config/places.json

# The assistant's LLM: any OpenAI-compatible API. Leave empty to answer rule-based only.
# The key stays here (server side); never in a NEXT_PUBLIC_* or EXPO_PUBLIC_* variable.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=8000

# Accounts and region alerts (Postgres). Leave DATABASE_URL empty to run without them: the live map and
# the assistant work as before. The tests use DATABASE_URL_TEST, a separate database they empty.
DATABASE_URL=
DATABASE_URL_TEST=

# The only e-mail domains that may sign up (exact match after the @), comma separated.
ALLOWED_EMAIL_DOMAINS=sakarya.edu.tr,ogr.sakarya.edu.tr

# Outgoing mail (sign-up codes, alert e-mails). Without SMTP_HOST, development writes every mail to
# services/api/.mail-outbox/ instead; production then refuses to sign anyone up. Keep SMTP_PASS here.
# Gmail (500 mails a day): SMTP_HOST=smtp.gmail.com, SMTP_USER = the address, SMTP_PASS = an app
# password (needs 2-Step Verification; the account's own password is refused), MAIL_FROM = the address.
# Mailjet (free plan: 6,000 mails a month, 200 a day): SMTP_HOST=in-v3.mailjet.com, SMTP_PORT=587,
# SMTP_USER = the API key, SMTP_PASS = the secret key (Account settings > SMTP). MAIL_FROM must be a
# sender address validated in Mailjet, or it refuses to send.
# At startup the API logs in once and prints "Mail: smtp ..., login ok" or why it failed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Campus Live <no-reply@campus-live.local>

# The web app's address, for the link in alert e-mails.
APP_URL=http://localhost:3000
