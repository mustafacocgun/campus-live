PORT=4000

# Browser origins allowed to call the API (the web app; Expo web on 8081). Phones need no entry.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Shared secret with the vision service (its VISION_INGEST_TOKEN). At least 16 characters; keep it in .env.
# Replace this placeholder with a random value: the API refuses to start with it.
VISION_INGEST_TOKEN=change-me-to-a-long-random-string

# A camera is shown as stale (grey) after this long without a reading.
STALE_AFTER_MS=15000

# The campus files at the repo root (the defaults); override only for another campus.
# CAMERAS_FILE=../../config/cameras.json
# PLACES_FILE=../../config/places.json

# The assistant's LLM: any OpenAI-compatible API. Without a key it answers rule-based only.
# The team's choice (docs/decisions.md D26): Google AI Studio's free tier. Get a free key at
# aistudio.google.com ("Get API key"). On the free tier Google may use the questions and human
# reviewers may read them: never put personal data in one (CLAUDE.md §0.4).
# The key stays here (server side); never in a NEXT_PUBLIC_* or EXPO_PUBLIC_* variable.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=8000
