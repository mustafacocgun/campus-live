VISION_API_URL=http://localhost:4000
# Must equal the API's VISION_INGEST_TOKEN. A secret: keep it in .env only.
# Replace this placeholder with a random value: the API refuses to start with it.
VISION_INGEST_TOKEN=change-me-to-a-long-random-string
# yolo: live YOLO on your footage (the yolo extra). replay: plays VISION_REPLAY_FILE, recorded once
# with `python -m vision.record` (no GPU needed). test-boxes: synthetic test clips only.
VISION_DETECTOR=yolo
VISION_REPLAY_FILE=recordings/demo.jsonl
# The example runs nothing (no footage). Your copy with sources: configs/cameras.yaml (git-ignored).
VISION_CAMERAS_FILE=configs/cameras.example.yaml
VISION_PUBLISH_INTERVAL_S=0.5
VISION_PORT=8001
