# Dependencies and build output
node_modules/
dist/
build/
.next/
.expo/
out/
coverage/
*.tsbuildinfo
next-env.d.ts

# Secrets: only .env.example files are tracked
.env
.env.*
!.env.example

# Development mail (sign-up codes and alerts written instead of sent): addresses, never committed
services/api/.mail-outbox/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Vision data: videos and model weights are never committed (CLAUDE.md §0.3)
services/vision/videos/
services/vision/datasets/

# MapLibre's worker, copied from node_modules before dev and build
apps/web/public/maplibre-gl-worker.mjs
services/vision/configs/cameras.yaml
# Parts of it for more than one vision process (cameras.part1.yaml, ...)
services/vision/configs/cameras.*.yaml
!services/vision/configs/cameras.example.yaml
services/vision/models/*
!services/vision/models/.gitkeep
*.pt
*.onnx

# Native projects generated by `expo prebuild`
apps/mobile/ios/
apps/mobile/android/

# Local tooling and OS files
.superpowers/
.DS_Store
*.log
.vscode/
.idea/
